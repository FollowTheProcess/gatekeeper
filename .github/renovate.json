{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy"],
  "postUpgradeTasks": {
    "commands": ["nix-update --flake --version=skip default"],
    "fileFilters": ["flake.nix"]
  },
  "nix": {
    "enabled": true
  }
}
